# Roboflow API Key (required for YOLO detection)
# Get this from https://roboflow.com
ROBOFLOW_API_KEY=your_api_key_here

# Flask Configuration
FLASK_DEBUG=False          # Set to True only for development
FLASK_HOST=127.0.0.1      # Use 127.0.0.1 for local only, 0.0.0.0 to expose to network
FLASK_PORT=5000           # Port to run the Flask app on
