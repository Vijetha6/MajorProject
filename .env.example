# Roboflow API Key (required for YOLO detection)
# Get this from https://roboflow.com
ROBOFLOW_API_KEY=your_api_key_here

# Flask Configuration
FLASK_DEBUG=False          # Set to True only for development
FLASK_HOST=127.0.0.1      # Use 127.0.0.1 for local only, 0.0.0.0 to expose to network
FLASK_PORT=5000           # Port to run the Flask app on

# Required for prescription PDF generation. Use actual identities; the
# application does not supply placeholder doctor or clinic details.
DOCTOR_NAME=
CLINIC_NAME=
# Optional clinic contact details; blank values are omitted from the PDF.
CLINIC_TAGLINE=
CLINIC_ADDRESS=
CLINIC_PHONE=
CLINIC_EMAIL=

# Optional external integrations
GOOGLE_DRIVE_UPLOAD_ENABLED=False
PUBLIC_BASE_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
